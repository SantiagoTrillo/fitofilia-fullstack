{
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "aplicacion",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "imagenes",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/logo.png",
          "/icons/*.png"
        ]
      }
    }
  ]
}